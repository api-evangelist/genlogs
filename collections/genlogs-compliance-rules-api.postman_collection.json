                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"rules\": [\n    {\n      \"rule_result_description\": \"string\",\n      \"status\": \"string\",\n      \"category\": \"string\",\n      \"rule_order\": \"string\"\n    },\n    {\n      \"rule_result_description\": \"string\",\n      \"status\": \"string\",\n      \"category\": \"string\",\n      \"rule_order\": \"string\"\n    }\n  ],\n  \"rule_status\": {\n    \"pass\": {\n      \"total\": 9776\n    },\n    \"fail\": {\n      \"total\": 8934\n    },\n    \"review\": {\n      \"total\": 2760\n    }\n  }\n}",
