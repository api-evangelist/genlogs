        {
          "id": "1014ac06-ba24-42e5-8c41-61de513b64e5",
          "name": "Create mismatch observation alerts",
          "request": {
            "name": "Create mismatch observation alerts",
            "description": {
              "content": "Creates one alert row per standalone USDOT or MC value, and one combined row per item in `pairs`. At least one of `usdots`, `mcs`, or `pairs` must be non-empty. `alert_name` is optional; when omitted or blank, stored as null. `logos` is optional and, when present, is normalized to lowercase, stored in `logos`, and used by mismatch detection. Logo matching remains case-insensitive. Unknown JSON properties are rejected.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mismatch-observations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logos\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"alert_name\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
