{
  "opencollection": "1.0.0",
  "info": {
    "name": "GenLogs Alerts auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create access and refresh tokens",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.genlogs.io/auth/token",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Email of the user requesting tokens."
              },
              {
                "name": "password",
                "value": "",
                "type": "query",
                "description": "Password of the user requesting tokens."
              }
            ]
          },
          "docs": "Create and return new access and refresh tokens for a user based on their email and password."
        },
        {
          "info": {
            "name": "Get the AccessToken And Refresh Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.genlogs.io/auth/token/refresh",
            "headers": [
              {
                "name": "accept",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "refresh_token",
                "value": "",
                "type": "query",
                "description": "The previously created valid refresh token"
              }
            ]
          },
          "docs": "Get the AccessToken And Refresh Token"
        }
      ]
    }
  ],
  "bundled": true
}