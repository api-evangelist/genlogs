{
  "item": [
    {
      "id": "54d8eb90-7c6c-4e4d-9511-fba51a2d8175",
      "name": "Facilities",
      "description": {
        "content": "",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "18cf3074-7776-4d46-954a-6e9a4a750991",
          "name": "Search facilities by name, address, zip code, city/state, website domain, or coordinates",
          "request": {
            "name": "Search facilities by name, address, zip code, city/state, website domain, or coordinates",
            "description": {
              "content": "Unified facility search. Provide at least one of: non-empty **`name`**, non-empty **`address`**, **`zip_code`**, non-empty **`website_domain`**, or both **`city`** and **`state`** (then use **`radius`** around the geocoded point). You may also pass **`location`** as `latitude,longitude` for radius search instead of city/state.\nOptionally include lane data per facility with **`include_lanes=true`**. Lanes can be filtered by **`min_distance`** (miles from facility) and **`direction`** (compass direction). Filters are applied before the **`top_n`** limit.\n\n## Pagination\n\nWhen results exceed 100 facilities, the response is paginated using opaque cursor-based pagination. The `Link` response header contains a next-page URL with a `cursor` parameter. Follow that URL to retrieve subsequent pages. The `X-Total-Count` header shows the total matching facilities across all pages. Pagination is not supported with `smart_search=true`.\nSee component schema **FacilitiesQueryCriteria** for the full parameter model and validation shape.\nHistorical path `/find_facilities` exposes the same search behavior and is documented here as **`/facilities`** for a single contract.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "facilities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Facility or collection name (optional if `address`, both `city` and `state`, or `website_domain` are provided).\nSee **FacilitiesQueryCriteria** for validation rules.\n"
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Substring match on formatted address (optional if `name`, both `city` and `state`, or `website_domain` are provided).\n"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City; use with `state` for geocoded radius search unless `name`, `address`, or `website_domain` alone is sufficient."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "State; use with `city` unless `name`, `address`, or `website_domain` supplies the search mode."
                },
                {
                  "disabled": false,
                  "key": "website_domain",
                  "value": "<string>",
                  "description": "Substring match against the shipper's `contact_url`. Must include the TLD\n(e.g. `acme.com`). Optional path tails (`acme.com/about`) are accepted by\nthe validator but the path is stripped before matching — only the host\nis searched.\n\n**Mutually exclusive with `name` and `address`.** If `name` or `address`\nis also supplied, `website_domain` is silently ignored (see\n**FacilitiesQueryCriteria** → *Filter precedence*). Also ignored when\n`smart_search=true` is used together with `name`.\n"
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Comma-separated `latitude,longitude`; radius applies around this point when provided instead of city/state."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<number>",
                  "description": "Search radius in miles around the geocoded city/state point or `location`"
                },
                {
                  "disabled": false,
                  "key": "lot_size_category",
                  "value": "<string>",
                  "description": "Lot size category filter"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of facilities to return"
                },
                {
                  "disabled": false,
                  "key": "facility_type",
                  "value": "<string>",
                  "description": "Optional place category filter (pipe-separated values accepted by the service)"
                },
                {
                  "disabled": false,
                  "key": "intermodal_drayage",
                  "value": "<string>",
                  "description": "Optional intermodal drayage filter flag"
                },
                {
                  "disabled": false,
                  "key": "include_lanes",
                  "value": "<boolean>",
                  "description": "Include inbound and outbound lane data for each facility. Lanes are ranked by weight."
                },
                {
                  "disabled": false,
                  "key": "top_n",
                  "value": "10",
                  "description": "Number of top lanes to return per direction (inbound/outbound) per facility."
                },
                {
                  "disabled": false,
                  "key": "min_distance",
                  "value": "<number>",
                  "description": "Minimum distance in miles from the facility to a lane destination. Lanes closer than this distance are excluded. Applied before top_n."
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "<string>",
                  "description": "Filter lanes by compass direction from the facility. Applied before top_n."
                },
                {
                  "disabled": false,
                  "key": "zip_code",
                  "value": "<string>",
                  "description": "US zip code; searches facilities near the zip centroid."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor from the Link header of a previous response.\nWhen results exceed 100 facilities, the server returns a Link header\ncontaining a next-page URL with this cursor embedded. Follow that URL\nto retrieve subsequent pages. Do not construct or parse this value —\nit is server-controlled and opaque.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Access Token for authentication",
                "key": "Access-Token",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) X api key for authentication",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
